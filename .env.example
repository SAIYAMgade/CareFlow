# CareFlow Healthcare Operations Platform Configuration

# Database Dialect: "oracle" for Oracle Database Free (23ai/21c), or "sqlite" for lightweight demo
DATABASE_DIALECT=sqlite

# Oracle Database Connection Settings (when DATABASE_DIALECT=oracle)
ORACLE_USER=careflow_admin
ORACLE_PASSWORD=CareFlowSecretPass2026#
ORACLE_DSN=localhost:1521/FREEPDB1
ORACLE_CONFIG_DIR=

# SQLite Database Settings (when DATABASE_DIALECT=sqlite)
SQLITE_PATH=./careflow.db

# API and Application Settings
API_PREFIX=/api
ENVIRONMENT_NAME=Simulated Clinical Environment (Synthetic Data)
DEBUG=true
PORT=8000
HOST=0.0.0.0

# CORS Allowed Origins (comma separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
